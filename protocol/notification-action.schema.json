{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "所选通知操作",
  "type": "object",
  "required": [
    "message_ids"
  ],
  "properties": {
    "message_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "additionalProperties": false
}
