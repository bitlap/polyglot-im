{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polyglot IM HTTP response",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "code",
        "message",
        "data"
      ],
      "properties": {
        "code": {
          "const": 200
        },
        "message": {
          "const": "success"
        },
        "data": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "code",
        "message",
        "data",
        "error_code",
        "request_id",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "null"
        },
        "error_code": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  ]
}
